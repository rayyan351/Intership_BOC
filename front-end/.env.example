# Copy to .env.local for local development. Never commit the real file.
# NEXT_PUBLIC_* values are inlined at BUILD time — set them in Vercel before
# deploying, and redeploy after any change.

# API base. Note the /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend origin. No /api suffix. Powers the /uploads/* rewrite in next.config.mjs.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# This site's own public origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The frontend reads Mongo directly in src/lib/dbConnect.js.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Must match REVALIDATION_SECRET on the backend.
REVALIDATION_SECRET=<generate with: openssl rand -hex 32>
