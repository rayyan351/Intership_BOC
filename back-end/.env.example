# Copy to .env for local development. Never commit the real .env.
# Render provides PORT automatically — do not set it there.
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=<generate with: openssl rand -hex 32>

# Storefront origin. Used for CORS and for ISR revalidation callbacks.
# Comma-separate to allow more than one origin.
FRONTEND_URL=http://localhost:3000

# Shared with the frontend — both sides must use the same value.
REVALIDATION_SECRET=<generate with: openssl rand -hex 32>

SAFEPAY_API_KEY=<key>
SAFEPAY_WEBHOOK_SECRET=<secret>
SAFEPAY_ENV=sandbox
